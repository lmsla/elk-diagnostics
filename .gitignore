# 編譯產物（僅排除 repo 根目錄下的輸出檔，不影響 cmd/ 原始碼目錄）
/elk-diagnostics
/elk-diagnostics-*
/dist/
/.cache/
/.tmp/

# macOS
.DS_Store

# 實測產出的診斷報告（可能含客戶叢集資訊）
/report*.html
/reports/
/check-report.*

# collect.sh 的預設輸出目錄
/elk-bundle-*/
# docs/內部/Podman測試環境.md 流程建議的 bundle 輸出（bundle-baseline 等）
/bundle-*/

# 本機 ES 測試環境產生的自簽 CA、憑證與私鑰
/dev/phase0/certs/
/dev/phase0/runtime/

# 連線設定（含認證憑證，僅保留 .example 範本）
config.yaml
