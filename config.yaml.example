# 複製為 config.yaml 後填入。連線資訊是唯一必填（見 docs/內部/規格/設定規格.md）。
# 也可改用 flag（--host/--api-key…）或環境變數（ELK_DIAGNOSTICS_*）提供，優先序：flag > env > 本檔 > 預設。
cluster:
  hosts:
    - "https://es.example.local:9200"
    # - "https://es-2.example.local:9200"   # 同叢集多節點，依序故障轉移
  auth:
    type: basic            # none | basic | api_key | bearer
    username: "elastic"    # 密碼由執行時的終端安全詢問
    # password: "..."      # 僅向下相容；正式環境不得將密碼寫入檔案
    # api_key: "..."       # type=api_key；正式環境由秘密管理機制注入
    # token: "..."         # type=bearer
  tls:
    ca_cert: "/path/to/ca.crt"     # 自簽 CA（政府/金融常見）；公開 CA 可留空
    # client_cert: "/path/tls.crt" # mTLS 才需要
    # client_key: "/path/tls.key"
    insecure_skip_verify: false    # 設 true 會在報告與 log 強制警告，僅限測試
  timeout_seconds: 10
  retries: 2
